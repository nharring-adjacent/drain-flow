// src/query/logql.pest

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// Entry point for a LogQL query
// For now, it's just a stream selector, optionally followed by line filters.
// FIXME: Expand to include full LogQL syntax (aggregations, etc.)
query = { SOI ~ log_stream_selector ~ (line_filter_expr)* ~ EOI }

// Log Stream Selector: { label_matcher ("," label_matcher)* }
log_stream_selector = { "{" ~ label_matcher ~ ("," ~ label_matcher)* ~ "}" }

label_matcher = { label_name ~ matcher_op ~ quoted_string }
label_name = @{ (ASCII_ALPHANUMERIC | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* } // Based on Prometheus label names

matcher_op = { "=" | "!=" | "=~" | "!~" }

// Line Filter Expressions
// Examples: |= "error", != "info", |~ "regex.*", !~ "another_regex"
// FIXME: Add support for `| line_format expression` and `| label_format expression`
// FIXME: Add support for `| json expression` and `| logfmt expression`
// FIXME: Add support for `| unwrap identifier` and `| unwrap duration(identifier)`
// FIXME: Add support for `| distinct (identifier (,...)*)?`
// FIXME: Add support for `| decfmt (identifier (,...)*)?`
line_filter_expr = { line_filter_op ~ quoted_string }

line_filter_op = { "|=" | "!=" | "|~" | "!~" }

// Utility rules
quoted_string = @{ """ ~ inner_string_double_quotes ~ """ | "'" ~ inner_string_single_quotes ~ "'" }
inner_string_double_quotes = { ( !(""" | "\\") ~ ANY )* ~ ("\\" ~ ANY ~ ( !(""" | "\\") ~ ANY )* )* }
inner_string_single_quotes = { ( !("'") ~ ANY )* } // Simplified for now, can be expanded for escapes if needed

// Comments - LogQL uses # for comments, but Pest processes them out if not explicitly handled.
// If we want to ignore them at a higher level, this might not be strictly needed here
// unless comments can appear in specific places that break simple whitespace skipping.
// For now, relying on WHITESPACE for simplicity.
// COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }

// Built-in Pest rules
// ASCII_ALPHANUMERIC = _{ 'a'..'z' | 'A'..'Z' | '0'..'9' }
// SOI = Start of Input
// EOI = End of Input
